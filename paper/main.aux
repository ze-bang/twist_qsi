\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces FCC-32 simple-loop hierarchy. Solid symbols are the complete virtual-depth-$d=2$ results; open symbols are matched virtual-depth-$d=3$ checks. Dashed curves are the leading ratios in Eq.\nobreakspace  {}(\ref  {eq:theoryratios}). Bare perturbation theory predicts that the longer loops approach or exceed the hexagon near $|J_{\pm }|/J_{zz}=0.30$; the nonperturbative Feshbach amplitudes flatten far below it.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:loops}{{4}{7}{FCC-32 simple-loop hierarchy. Solid symbols are the complete virtual-depth-$d=2$ results; open symbols are matched virtual-depth-$d=3$ checks. Dashed curves are the leading ratios in Eq.~(\ref {eq:theoryratios}). Bare perturbation theory predicts that the longer loops approach or exceed the hexagon near $|\Jpm |/\Jzz =0.30$; the nonperturbative Feshbach amplitudes flatten far below it}{figure.4}{}}
